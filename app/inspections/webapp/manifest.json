{
  "_version": "1.65.0",
  "sap.app": {
    "id": "retcl.inspections",
    "type": "application",
    "title": "Condition Logging & Inspections",
    "description": "Perform check-out departure and return check-in inspections, condition grading (A-D), and meter tracking",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/inspection/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ConditionLogsList",
          "target": "ConditionLogsList"
        },
        {
          "pattern": "ConditionLogs({key}):?query:",
          "name": "ConditionLogsObjectPage",
          "target": "ConditionLogsObjectPage"
        }
      ],
      "targets": {
        "ConditionLogsList": {
          "type": "Component",
          "id": "ConditionLogsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "ConditionLogs",
              "liveMode": true,
              "navigation": {
                "ConditionLogs": {
                  "detail": {
                    "route": "ConditionLogsObjectPage"
                  }
                }
              }
            }
          }
        },
        "ConditionLogsObjectPage": {
          "type": "Component",
          "id": "ConditionLogsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "ConditionLogs",
              "controlConfiguration": {
                "photos/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "capturePhoto": {
                      "press": "retcl.inspections.ext.controller.PhotoUpload.onCapturePhoto",
                      "text": "Capture Photo",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
