{
  "_version": "1.65.0",
  "sap.app": {
    "id": "retcl.locations",
    "type": "application",
    "title": "Depot & Yard Locations",
    "description": "Manage equipment yards, workshops, plant codes, and depot geolocation telemetry",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/rental/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "LocationsList",
          "target": "LocationsList"
        },
        {
          "pattern": "Locations({key}):?query:",
          "name": "LocationsObjectPage",
          "target": "LocationsObjectPage"
        }
      ],
      "targets": {
        "LocationsList": {
          "type": "Component",
          "id": "LocationsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Locations",
              "liveMode": true,
              "navigation": {
                "Locations": {
                  "detail": {
                    "route": "LocationsObjectPage"
                  }
                }
              }
            }
          }
        },
        "LocationsObjectPage": {
          "type": "Component",
          "id": "LocationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Locations",
              "controlConfiguration": {
                "equipment/@UI.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "AssignEquipment": {
                      "press": "RentalService.assignEquipment",
                      "text": "Assign Equipment",
                      "visible": "{= ${IsActiveEntity} === true }"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
