{
  "_version": "1.65.0",
  "sap.app": {
    "id": "retcl.damagechargeapproval",
    "type": "application",
    "title": "Damage Charge Approval",
    "description": "Worklist for reviewing, approving and adjusting customer repair billing",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/billing/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "resources": {
  "css": [
    {
      "uri": "css/rets-theme.css"
    }
  ]
},
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "RepairBillsList",
          "target": "RepairBillsList"
        },
        {
          "pattern": "RepairBills({key}):?query:",
          "name": "RepairBillsObjectPage",
          "target": "RepairBillsObjectPage"
        }
      ],
      "targets": {
        "RepairBillsList": {
          "type": "Component",
          "id": "RepairBillsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "RepairBills",
              "liveMode": true,
              "navigation": {
                "RepairBills": {
                  "detail": {
                    "route": "RepairBillsObjectPage"
                  }
                }
              }
            }
          }
        },
        "RepairBillsObjectPage": {
          "type": "Component",
          "id": "RepairBillsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "RepairBills",
              "controlConfiguration": {
                "photos/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "capturePhoto": {
                      "press": "retcl.damagechargeapproval.ext.controller.PhotoUpload.onCapturePhoto",
                      "text": "Capture Photo",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
