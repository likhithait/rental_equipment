# Copy to cloudinary.mtaext (git-ignored), fill in your Cloudinary credentials and deploy with
#   cf deploy mta_archives/sprint_1.0.0.mtar -e cloudinary.mtaext
_schema-version: '3.1'
ID: sprint.cloudinary
extends: sprint

modules:
  - name: sprint-srv
    properties:
      CLOUDINARY_URL: cloudinary://<api_key>:<api_secret>@<cloud_name>
